{
    "version": "2.15.1",
    "description": "A Windows video and audio downloader built on yt-dlp, with format choices, a persistent queue and searchable history.",
    "homepage": "https://github.com/SysAdminDoc/AstraDownloader",
    "license": "MIT",
    "notes": [
        "This package installs the portable one-folder layout, so Astra Downloader keeps its state in the data folder beside the executable rather than in %LOCALAPPDATA%.",
        "That whole folder is persisted, so an update keeps your settings, history, queue, subscriptions and stored sign-ins, and does not download yt-dlp, FFmpeg or the JavaScript runtime again.",
        "'scoop uninstall -p astra-downloader' removes that folder along with the app."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/SysAdminDoc/AstraDownloader/releases/download/v2.15.1/AstraDownloader-onedir.zip",
            "hash": "2a0ff287ae5d6201750617f73ecee0c23ecf2bb12d29cd672e1d91358ebfad5c",
            "extract_dir": "AstraDownloader"
        }
    },
    "bin": "AstraDownloader.exe",
    "shortcuts": [
        [
            "AstraDownloader.exe",
            "Astra Downloader"
        ]
    ],
    "persist": [
        "data"
    ],
    "pre_install": [
        "# Carry an install made by the previous manifest onto the data layout.",
        "# Runs before Scoop links the persist entries, and skips anything already",
        "# moved, so it is a no-op on a fresh install and on every later update.",
        "$legacy = @('config.json', 'history.json', 'download-queue.json', 'subscriptions.json', 'site-logins', 'server.log', 'crash.log', 'yt-dlp-update-state.json', 'companion-update-state.json', 'yt-dlp.exe', 'ffmpeg.exe', 'deno', 'quickjs', 'whisper', 'native-hosts')",
        "$data = Join-Path $persist_dir 'data'",
        "if (-not (Test-Path $data)) {",
        "    New-Item -ItemType Directory -Path $data -Force | Out-Null",
        "}",
        "foreach ($name in $legacy) {",
        "    $old = Join-Path $persist_dir $name",
        "    $new = Join-Path $data $name",
        "    if ((Test-Path -LiteralPath $old) -and -not (Test-Path -LiteralPath $new)) {",
        "        Move-Item -LiteralPath $old -Destination $new -Force",
        "        Write-Host \"Moved $name into the data folder.\"",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/SysAdminDoc/AstraDownloader"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SysAdminDoc/AstraDownloader/releases/download/v$version/AstraDownloader-onedir.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
