{
  "private": true,
  "name": "astra-downloader",
  "version": "2.15.0",
  "description": "A desktop video downloader for Windows. Paste a link from almost any site. It also serves the Astra Deck browser extension over a local API.",
  "author": "SysAdminDoc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SysAdminDoc/AstraDownloader.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/run-checks.js",
    "check:companion-ports": "node scripts/check-companion-port-catalogue.js",
    "check:catch-reasons": "node scripts/check-python-catch-reasons.js",
    "check:companion-inventory": "node scripts/check-companion-inventory.js",
    "check:site-registry": "py -3.13 scripts/check-site-registry.py",
    "check:translations": "py -3.13 scripts/check-companion-translations.py",
    "check:versions": "node scripts/check-versions.js",
    "audit:python": "node scripts/audit-python-deps.js",
    "generate:companion-ports": "node scripts/generate-companion-port-modules.js",
    "smoke:gui": "py -3.13 scripts/render-companion-gui.py",
    "smoke:yt-dlp": "py -3.13 scripts/yt-dlp-smoke.py",
    "smoke:yt-dlp:managed": "py -3.13 scripts/yt-dlp-smoke.py --managed",
    "translations": "py -3.13 scripts/build-companion-translations.py",
    "release:provenance": "node scripts/write-release-provenance.js",
    "release:helpers": "node scripts/resolve-runtime-helpers.js",
    "release:stage": "node scripts/stage-companion-release.js"
  }
}
