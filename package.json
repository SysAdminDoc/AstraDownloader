{
  "private": true,
  "name": "astra-downloader",
  "version": "2.1.0",
  "description": "A desktop video downloader for Windows — paste a link from almost any site. Also serves the Astra Deck browser extension over a local API.",
  "author": "SysAdminDoc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SysAdminDoc/AstraDownloader.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run check:companion-ports && npm run check:catch-reasons && npm run check:versions && npm run audit:python",
    "check:companion-ports": "node scripts/check-companion-port-catalogue.js",
    "check:catch-reasons": "node scripts/check-python-catch-reasons.js",
    "check:versions": "node scripts/check-versions.js",
    "audit:python": "node scripts/audit-python-deps.js",
    "generate:companion-ports": "node scripts/generate-companion-port-modules.js",
    "smoke:gui": "py -3.12 scripts/render-companion-gui.py",
    "smoke:yt-dlp": "py -3.12 scripts/yt-dlp-smoke.py",
    "translations": "py -3.12 scripts/build-companion-translations.py",
    "release:stage": "node scripts/stage-companion-release.js"
  }
}
